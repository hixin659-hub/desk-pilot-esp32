# 默认配置模板 —— 拷贝为 sdkconfig 或在 menuconfig 中修改
#
# 本文件不包含真实的敏感信息，真实凭据请写在本地 sdkconfig 中，
# 且 sdkconfig 不应提交到公开仓库。

# ---- 配网热点 ----
CONFIG_APP_WIFI_AP_SSID="ESP32_AP"
CONFIG_APP_WIFI_AP_PASSWORD=""
CONFIG_APP_WIFI_AP_CHANNEL=5
CONFIG_APP_WIFI_AP_MAX_CONN=2

# ---- 心知天气 ----
CONFIG_APP_WEATHER_API_KEY=""
CONFIG_APP_WEATHER_LOCATION="nanyang"
CONFIG_APP_WEATHER_INTERVAL_S=1800

# ---- AIDA64 ----
CONFIG_APP_AIDA64_DEFAULT_IP="192.168.1.2"
CONFIG_APP_AIDA64_PORT=80

# ---- 摄像头 ----
CONFIG_APP_CAMERA_FPS=15
CONFIG_APP_CAMERA_JPEG_POOL_KB=8

# ---- 视频播放器 ----
CONFIG_APP_VIDEO_FPS_LIMIT=15
CONFIG_APP_VIDEO_AUDIO_DMA_DESC=6
CONFIG_APP_VIDEO_AUDIO_DMA_FRAMES=256

# ---- 功能开关 ----
CONFIG_APP_ENABLE_CAMERA=y
CONFIG_APP_ENABLE_VIDEO_PLAYER=y
CONFIG_APP_ENABLE_WEATHER=y
CONFIG_APP_ENABLE_MONITOR=y
